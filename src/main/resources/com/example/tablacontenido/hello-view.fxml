<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="560.0" prefWidth="709.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tablacontenido.HelloController">
    <children>
        <Button layoutX="39.0" layoutY="15.0" onAction="#onAbrirArchivo" text="Abrir archivo" />
        <Label fx:id="etiquetaArchivo" layoutX="150.0" layoutY="19.0" text="Ningun archivo cargado" />

        <TableView fx:id="tablaContenido" layoutX="39.0" layoutY="55.0" prefHeight="470.0" prefWidth="632.0">
            <columns>
                <TableColumn fx:id="colLexema" prefWidth="200.0" text="Lexema" />
                <TableColumn fx:id="colTipo" prefWidth="180.0" text="Tipo" />
                <TableColumn fx:id="colLinea" prefWidth="85.0" text="Linea" />
                <TableColumn fx:id="colInicio" prefWidth="85.0" text="Inicio" />
                <TableColumn fx:id="colFin" prefWidth="85.0" text="Fin" />
            </columns>
        </TableView>
    </children>
</Pane>
